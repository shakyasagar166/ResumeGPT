# ========================================================
# ResumeGPT - Environment Configuration
# ========================================================

# Application Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider Configuration
# Supported options: "gemini" | "openai" | "groq" | "mock"
LLM_PROVIDER=gemini

# Google Gemini Settings (Default & Recommended)
# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Settings (Optional alternative)
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq Settings (Optional alternative for ultra-fast inference)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
